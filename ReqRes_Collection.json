        {
          "name": "POST - Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Name matches CSV data\", function () {\r\n    const res = pm.response.json();\r\n    pm.expect(res.name).to.eql(pm.iterationData.get(\"name\"));\r\n});\r\n\r\npm.test(\"Job matches CSV data\", function () {\r\n    const res = pm.response.json();\r\n    pm.expect(res.job).to.eql(pm.iterationData.get(\"job\"));\r\n});\r\n\r\npm.test(\"Response has user ID\", function () {\r\n    const res = pm.response.json();\r\n    pm.expect(res).to.have.property(\"id\");\r\n});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Khai báo 3 dòng dữ liệu thay cho file CSV\r\nvar testData = [\r\n    { name: \"An Nguyen\", job: \"QA Lead\" },\r\n    { name: \"Bao Tran\", job: \"Automation Tester\" },\r\n    { name: \"Chi Le\", job: \"Software Engineer\" }\r\n];\r\n\r\n// Lấy chỉ số lần chạy tự động hoặc mặc định dòng đầu tiên\r\nvar iteration = pm.info.iteration || 0;\r\nvar currentData = testData[iteration % testData.length];\r\n\r\n// Gán dữ liệu vào biến môi trường để Body nhận diện {{name}} và {{job}}\r\npm.environment.set(\"name\", currentData.name);\r\npm.environment.set(\"job\", currentData.job);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disabledSystemHeaders": {}
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "QpwL5tke4Pnpja7X4"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
