        {
          "name": "POST - Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response has token\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json).to.have.property(\"token\");\r\n});\r\n\r\nconst json = pm.response.json();\r\n\r\nif (json.token) {\r\n    pm.environment.set(\"userToken\", json.token);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "free_user_3L2UWtlvr3w7SP2uPTlHUJCrCZ3"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"eve.holt@reqres.in\",\r\n  \"password\": \"pistol\"\r\n}",
